#. Plugin plugin name.
#: iamagnus-chat.php includes/class-iamagnus-chat-settings.php:99 includes/class-iamagnus-chat-settings.php:100 includes/class-iamagnus-chat-settings.php:228 includes/class-iamagnus-chat-settings.php:301
msgid "Magnus Chat"
msgstr "Magnus Chat"

#. Plugin description.
#: iamagnus-chat.php
msgid "Puts a Magnus agent on your site: a chat window that answers your visitors through the Magnus API. The API key stays on your server."
msgstr "Pone un agente de Magnus en tu sitio: una ventana de chat que responde a tus visitantes a través de la API de Magnus. La API key queda en tu servidor."

#. Plugin author.
#: iamagnus-chat.php
msgid "Magnus"
msgstr "Magnus"

#: includes/class-iamagnus-chat-client.php:238
msgid "There are many questions right now. Please try again in a minute."
msgstr "Hay muchas consultas en este momento. Inténtalo de nuevo en un minuto."

#: includes/class-iamagnus-chat-client.php:240 includes/class-iamagnus-chat-widget.php:68
msgid "I can’t answer right now. Please try again in a few minutes."
msgstr "No puedo responder en este momento. Inténtalo de nuevo en unos minutos."

#: includes/class-iamagnus-chat-client.php:256
msgid "Magnus could not be reached. Check the address and that this server can make outgoing HTTPS requests."
msgstr "No se pudo llegar a Magnus. Revisa la dirección y que este servidor pueda hacer pedidos HTTPS salientes."

#: includes/class-iamagnus-chat-client.php:259
msgid "Magnus accepted the key, but its organization is deactivated."
msgstr "Magnus aceptó la key, pero su organización está desactivada."

#: includes/class-iamagnus-chat-client.php:262
msgid "The key does not belong to any organization. Create a System API key in the Magnus dashboard."
msgstr "La key no pertenece a ninguna organización. Crea una System API key en el panel de Magnus."

#: includes/class-iamagnus-chat-client.php:264
msgid "Magnus rejected the API key. Create a new one in the Magnus dashboard and paste it here."
msgstr "Magnus rechazó la API key. Crea una nueva en el panel de Magnus y pégala aquí."

#: includes/class-iamagnus-chat-client.php:266
msgid "Magnus is limiting this key: too many messages in the last hour. Ask Magnus for a higher limit if your site needs it."
msgstr "Magnus está limitando esta key: demasiados mensajes en la última hora. Pídele a Magnus un límite mayor si tu sitio lo necesita."

#. translators:%d: HTTP status code
#: includes/class-iamagnus-chat-client.php:269
msgid "Magnus failed (HTTP %d). It usually passes; if it does not, contact Magnus."
msgstr "Magnus falló (HTTP %d). Suele pasar solo; si no, contacta a Magnus."

#: includes/class-iamagnus-chat-client.php:271
msgid "Magnus answered with an empty message."
msgstr "Magnus respondió con un mensaje vacío."

#. translators:1: HTTP status code, 2: Magnus error code
#: includes/class-iamagnus-chat-client.php:275
msgid "Magnus refused the request (HTTP %1$d %2$s)."
msgstr "Magnus rechazó el pedido (HTTP %1$d %2$s)."

#: includes/class-iamagnus-chat-rest.php:70
msgid "The chat is not available right now."
msgstr "El chat no está disponible en este momento."

#: includes/class-iamagnus-chat-rest.php:75
msgid "Write a message first."
msgstr "Escribe un mensaje primero."

#. translators:%d: maximum number of characters
#: includes/class-iamagnus-chat-rest.php:83 includes/class-iamagnus-chat-widget.php:71
msgid "Messages can be up to %d characters long."
msgstr "Los mensajes pueden tener hasta %d caracteres."

#: includes/class-iamagnus-chat-rest.php:87
msgid "That message can’t be sent as it is. Please write it inside a sentence."
msgstr "Ese mensaje no se puede enviar así. Escríbelo dentro de una frase."

#: includes/class-iamagnus-chat-settings.php:62
msgid "Chat with us"
msgstr "Chatea con nosotros"

#: includes/class-iamagnus-chat-settings.php:63
msgid "Hi! How can I help you?"
msgstr "¡Hola! ¿En qué te puedo ayudar?"

#: includes/class-iamagnus-chat-settings.php:64
msgid "Type your message…"
msgstr "Escribe tu mensaje…"

#: includes/class-iamagnus-chat-settings.php:148
msgid "The Magnus address must start with https:// (http:// only for localhost). The previous address was kept."
msgstr "La dirección de Magnus tiene que empezar con https:// (http:// solo para localhost). Se mantuvo la dirección anterior."

#: includes/class-iamagnus-chat-settings.php:216
msgid "Settings"
msgstr "Ajustes"

#: includes/class-iamagnus-chat-settings.php:227
msgid "When you use the chat on this site, what you write is sent to Magnus, the service that runs our virtual assistant, so that it can answer. Magnus keeps the conversation in order to continue it. Your name, email address and IP address are not sent with the messages: each browser is identified by a random code stored in it. Please do not write sensitive personal data in the chat."
msgstr "Cuando usas el chat de este sitio, lo que escribes se envía a Magnus, el servicio que hace funcionar nuestro asistente virtual, para que pueda responder. Magnus guarda la conversación para poder continuarla. Con los mensajes no se envían tu nombre, tu correo ni tu dirección IP: cada navegador se identifica con un código al azar guardado en él. Por favor, no escribas datos personales sensibles en el chat."

#: includes/class-iamagnus-chat-settings.php:236
msgid "You are not allowed to do this."
msgstr "No tienes permiso para hacer esto."

#: includes/class-iamagnus-chat-settings.php:254
msgid "There is no API key yet. Paste it above and save."
msgstr "Todavía no hay una API key. Pégala arriba y guarda."

#. translators:%s: the Magnus address, such as https://app.iamagnus.com
#: includes/class-iamagnus-chat-settings.php:263
msgid "Magnus does not answer at %s. Check the address."
msgstr "Magnus no responde en %s. Revisa la dirección."

#: includes/class-iamagnus-chat-settings.php:277
msgid "The key works, but its organization has no agent to answer."
msgstr "La key funciona, pero su organización no tiene ningún agente que responda."

#. translators:%s: the agent (or agents) the key answers as
#: includes/class-iamagnus-chat-settings.php:283
msgid "Connected. This key answers as: %s."
msgstr "Conectado. Esta key responde como: %s."

#: includes/class-iamagnus-chat-settings.php:307
msgid "Connection"
msgstr "Conexión"

#: includes/class-iamagnus-chat-settings.php:310
msgid "API key"
msgstr "API key"

#: includes/class-iamagnus-chat-settings.php:313
msgid "Saved. Leave empty to keep it."
msgstr "Guardada. Déjala vacía para conservarla."

#: includes/class-iamagnus-chat-settings.php:314
msgid "Create it in the Magnus dashboard, under API keys, for the agent that should answer on this site. It stays on this server: visitors never see it."
msgstr "Créala en el panel de Magnus, en API keys, para el agente que debe responder en este sitio. Queda en este servidor: los visitantes nunca la ven."

#: includes/class-iamagnus-chat-settings.php:316
msgid "Delete the saved key"
msgstr "Borrar la key guardada"

#: includes/class-iamagnus-chat-settings.php:321
msgid "Magnus address"
msgstr "Dirección de Magnus"

#: includes/class-iamagnus-chat-settings.php:324
msgid "Leave https://app.iamagnus.com unless Magnus gave you another address."
msgstr "Deja https://app.iamagnus.com salvo que Magnus te haya dado otra dirección."

#: includes/class-iamagnus-chat-settings.php:329
msgid "Chat window"
msgstr "Ventana de chat"

#: includes/class-iamagnus-chat-settings.php:332
msgid "Title"
msgstr "Título"

#: includes/class-iamagnus-chat-settings.php:336
msgid "Welcome message"
msgstr "Mensaje de bienvenida"

#: includes/class-iamagnus-chat-settings.php:339
msgid "Shown before the visitor writes. Empty fields use the text in gray, in the language of the site."
msgstr "Se muestra antes de que el visitante escriba. Los campos vacíos usan el texto en gris, en el idioma del sitio."

#: includes/class-iamagnus-chat-settings.php:343
msgid "Text in the message box"
msgstr "Texto en la caja de mensaje"

#: includes/class-iamagnus-chat-settings.php:347
msgid "Chat button"
msgstr "Botón de chat"

#: includes/class-iamagnus-chat-settings.php:349
msgid "Show a chat button in a corner of every page"
msgstr "Mostrar un botón de chat en una esquina de todas las páginas"

#: includes/class-iamagnus-chat-settings.php:351
msgid "Corner"
msgstr "Esquina"

#: includes/class-iamagnus-chat-settings.php:353
msgid "Bottom right"
msgstr "Abajo a la derecha"

#: includes/class-iamagnus-chat-settings.php:354
msgid "Bottom left"
msgstr "Abajo a la izquierda"

#: includes/class-iamagnus-chat-settings.php:360
msgid "Color"
msgstr "Color"

#: includes/class-iamagnus-chat-settings.php:367
msgid "Check the connection"
msgstr "Comprobar la conexión"

#: includes/class-iamagnus-chat-settings.php:368
msgid "Asks Magnus whether the address answers and whether the saved key is accepted. It does not send any message to the agent."
msgstr "Le pregunta a Magnus si la dirección responde y si acepta la key guardada. No le envía ningún mensaje al agente."

#: includes/class-iamagnus-chat-settings.php:372
msgid "Test the connection"
msgstr "Probar la conexión"

#: includes/class-iamagnus-chat-settings.php:375
msgid "The chat inside a page"
msgstr "El chat dentro de una página"

#. translators:%s: the shortcode
#: includes/class-iamagnus-chat-settings.php:380
msgid "Add %s to a page or post to show the chat inside it, instead of in a corner. On that page the corner button is not shown."
msgstr "Agrega %s a una página o entrada para mostrar el chat dentro de ella, en lugar de en una esquina. En esa página no se muestra el botón de la esquina."

#: includes/class-iamagnus-chat-settings.php:407
msgid "Paste the API key to turn the chat on. Until then nothing is shown to visitors."
msgstr "Pega la API key para encender el chat. Hasta entonces, los visitantes no ven nada."

#. translators:1: date and time, 2: what failed
#: includes/class-iamagnus-chat-settings.php:418
msgid "The last time a visitor wrote (%1$s), the chat could not answer: %2$s"
msgstr "La última vez que un visitante escribió (%1$s), el chat no pudo responder: %2$s"

#: includes/class-iamagnus-chat-widget.php:63
msgid "Open the chat"
msgstr "Abrir el chat"

#: includes/class-iamagnus-chat-widget.php:64
msgid "Close the chat"
msgstr "Cerrar el chat"

#: includes/class-iamagnus-chat-widget.php:65
msgid "Send"
msgstr "Enviar"

#: includes/class-iamagnus-chat-widget.php:66
msgid "New conversation"
msgstr "Nueva conversación"

#: includes/class-iamagnus-chat-widget.php:67
msgid "Writing…"
msgstr "Escribiendo…"

#: includes/class-iamagnus-chat-widget.php:69
msgid "No connection. Check your internet and try again."
msgstr "Sin conexión. Revisa tu internet e inténtalo de nuevo."

#: includes/class-iamagnus-chat-widget.php:72
msgid "You"
msgstr "Tú"

#: includes/class-iamagnus-chat-widget.php:73
msgid "Assistant"
msgstr "Asistente"

#: includes/class-iamagnus-chat-widget.php:105
msgid "Magnus Chat: paste the API key in Settings → Magnus Chat to show the chat here. Visitors see nothing until then."
msgstr "Magnus Chat: pega la API key en Ajustes → Magnus Chat para mostrar el chat aquí. Hasta entonces, los visitantes no ven nada."
